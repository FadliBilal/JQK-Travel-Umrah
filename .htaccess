# Enable Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache images for 1 month
    ExpiresByType image/jpeg A2592000
    ExpiresByType image/gif A2592000
    ExpiresByType image/png A2592000
    ExpiresByType image/webp A2592000
    ExpiresByType image/svg+xml A2592000
    
    # Cache CSS for 1 week
    ExpiresByType text/css A604800
    
    # Cache JavaScript for 1 week
    ExpiresByType application/javascript A604800
    ExpiresByType text/javascript A604800
    
    # Cache fonts for 1 month
    ExpiresByType font/ttf A2592000
    ExpiresByType font/otf A2592000
    ExpiresByType font/woff A2592000
    ExpiresByType font/woff2 A2592000
    
    # HTML expires in 1 day
    ExpiresByType text/html A86400
    ExpiresByType application/xhtml+xml A86400
</IfModule>

# Add Vary header for cached content with gzip
<IfModule mod_headers.c>
    <FilesMatch "\\.(js|css|xml|gz|html|woff|woff2|ttf|otf)$">
        Header append Vary: Accept-Encoding
    </FilesMatch>
</IfModule>

# Leverage browser caching
<IfModule mod_headers.c>
    # One month
    <FilesMatch "\\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    # One week
    <FilesMatch "\\.(css|js)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    # One day
    <FilesMatch "\\.(html|htm|xml|txt|xhtml)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>
